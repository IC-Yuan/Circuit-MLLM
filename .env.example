# Copy this file to .env and replace values marked /path/to/...

# Base MLLM. A Hugging Face model ID or a local directory is accepted.
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# Dataset root used to resolve relative image/helper/mask paths in JSONL files.
CIRCUIT_DATA_ROOT=/path/to/circuit_training_data
DATA_PATH=/path/to/circuit_training_data/combine/train.jsonl

# Training outputs and caches.
OUTPUT_ROOT=./outputs
HF_HOME=./.cache/huggingface
CUDA_VISIBLE_DEVICES=0
NUM_PROCESSES=1
MASTER_PORT=29501
HF_HUB_OFFLINE=0
