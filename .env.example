# Copy this file to .env and replace values marked /path/to/...

# Base MLLM. A Hugging Face model ID or a local directory is accepted.
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# Dataset root used to resolve relative image/helper/mask paths in JSONL files.
CIRCUIT_DATA_ROOT=/path/to/circuit_training_data
DATA_PATH=/path/to/circuit_training_data/combine/train.jsonl

# Training outputs and caches.
OUTPUT_ROOT=./outputs
HF_HOME=./.cache/huggingface
CUDA_VISIBLE_DEVICES=0
NUM_PROCESSES=1
MASTER_PORT=29501
HF_HUB_OFFLINE=0

# Expert checkpoints. Run scripts/download_expert_weights.sh for the defaults.
HAWP_WEIGHTS_PATH=./hawp/checkpoints/hawpv3-imagenet-03a84.pth
DEEPLSD_WEIGHTS_PATH=./DeepLSD/weights/deeplsd_md.tar
DINOV2_MODEL=facebook/dinov2-giant

# Evaluation. DATASET_DIR contains images referenced by the evaluation JSONL.
MODEL_DIR=/path/to/circuit-mllm-checkpoint
INPUT_DIR=/path/to/evaluation-jsonl-directory
DATASET_DIR=/path/to/evaluation-images
